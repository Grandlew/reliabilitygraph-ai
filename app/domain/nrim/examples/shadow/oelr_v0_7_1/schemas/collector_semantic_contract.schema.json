{
  "$defs": {
    "AggregationSemantics": {
      "additionalProperties": false,
      "properties": {
        "boundary_rule": {
          "maxLength": 500,
          "minLength": 3,
          "title": "Boundary Rule",
          "type": "string"
        },
        "denominator_semantics": {
          "maxLength": 500,
          "minLength": 3,
          "title": "Denominator Semantics",
          "type": "string"
        },
        "late_data_rule": {
          "maxLength": 500,
          "minLength": 3,
          "title": "Late Data Rule",
          "type": "string"
        },
        "numerator_semantics": {
          "maxLength": 500,
          "minLength": 3,
          "title": "Numerator Semantics",
          "type": "string"
        },
        "reset_behavior": {
          "$ref": "#/$defs/ResetBehavior"
        },
        "source_sampling_interval_seconds": {
          "exclusiveMinimum": 0.0,
          "title": "Source Sampling Interval Seconds",
          "type": "number"
        },
        "statistic": {
          "$ref": "#/$defs/AggregationStatistic"
        },
        "target_window_seconds": {
          "exclusiveMinimum": 0.0,
          "title": "Target Window Seconds",
          "type": "number"
        }
      },
      "required": [
        "statistic",
        "source_sampling_interval_seconds",
        "target_window_seconds",
        "reset_behavior",
        "numerator_semantics",
        "denominator_semantics",
        "boundary_rule",
        "late_data_rule"
      ],
      "title": "AggregationSemantics",
      "type": "object"
    },
    "AggregationStatistic": {
      "enum": [
        "last",
        "mean",
        "maximum",
        "count",
        "rate"
      ],
      "title": "AggregationStatistic",
      "type": "string"
    },
    "Applicability": {
      "enum": [
        "observed",
        "missing",
        "not_applicable"
      ],
      "title": "Applicability",
      "type": "string"
    },
    "ComponentType": {
      "enum": [
        "signal_source",
        "gateway",
        "streamer",
        "middleware",
        "database",
        "catchup_service",
        "catchup_storage",
        "epg_service",
        "core_switch",
        "distribution_switch",
        "smart_tv_group"
      ],
      "title": "ComponentType",
      "type": "string"
    },
    "MetricName": {
      "enum": [
        "system.disk.utilization",
        "system.disk.io_latency",
        "system.disk.io_errors",
        "iptv.catchup.recording_failures",
        "system.process.restart_count",
        "iptv.session.active_count",
        "iptv.catchup.service_availability"
      ],
      "title": "MetricName",
      "type": "string"
    },
    "MetricSemanticMapping": {
      "additionalProperties": false,
      "properties": {
        "aggregation": {
          "$ref": "#/$defs/AggregationSemantics"
        },
        "canonical_metric": {
          "$ref": "#/$defs/MetricName"
        },
        "canonical_unit": {
          "$ref": "#/$defs/MetricUnit"
        },
        "conversion_multiplier": {
          "title": "Conversion Multiplier",
          "type": "number"
        },
        "conversion_offset": {
          "default": 0.0,
          "title": "Conversion Offset",
          "type": "number"
        },
        "conversion_provenance": {
          "maxLength": 1000,
          "minLength": 10,
          "title": "Conversion Provenance",
          "type": "string"
        },
        "expected_source_unit": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Expected Source Unit",
          "type": "string"
        },
        "source_metric_name": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Source Metric Name",
          "type": "string"
        }
      },
      "required": [
        "source_metric_name",
        "canonical_metric",
        "expected_source_unit",
        "canonical_unit",
        "conversion_multiplier",
        "aggregation",
        "conversion_provenance"
      ],
      "title": "MetricSemanticMapping",
      "type": "object"
    },
    "MetricUnit": {
      "enum": [
        "percent",
        "milliseconds",
        "errors_per_interval",
        "failures_per_interval",
        "restarts_per_interval",
        "sessions"
      ],
      "title": "MetricUnit",
      "type": "string"
    },
    "ObservationQuality": {
      "enum": [
        "high",
        "medium",
        "low",
        "quarantined"
      ],
      "title": "ObservationQuality",
      "type": "string"
    },
    "ResetBehavior": {
      "enum": [
        "gauge",
        "interval_counter",
        "monotonic_counter"
      ],
      "title": "ResetBehavior",
      "type": "string"
    }
