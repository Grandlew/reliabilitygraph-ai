      "type": "number"
    },
    "maximum_ingestion_delay_seconds": {
      "exclusiveMinimum": 0.0,
      "title": "Maximum Ingestion Delay Seconds",
      "type": "number"
    },
    "metric_field": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Metric Field",
      "type": "string"
