      "maxLength": 1000,
      "minLength": 10,
      "title": "Event Timestamp Provenance",
      "type": "string"
    },
    "ingestion_time_field": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Ingestion Time Field",
      "type": "string"
    },
    "maximum_clock_skew_seconds": {
      "minimum": 0.0,
