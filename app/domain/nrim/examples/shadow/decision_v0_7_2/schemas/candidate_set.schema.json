{
  "$defs": {
    "CandidateCoverage": {
      "additionalProperties": false,
      "properties": {
        "adjudication_reference": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Adjudication Reference",
          "type": "string"
        },
        "denominator": {
          "exclusiveMinimum": 0,
          "title": "Denominator",
          "type": "integer"
        },
        "eligible_true_cause_count": {
          "minimum": 0,
          "title": "Eligible True Cause Count",
          "type": "integer"
        },
        "included_true_cause_count": {
          "minimum": 0,
          "title": "Included True Cause Count",
          "type": "integer"
        }
      },
      "required": [
        "eligible_true_cause_count",
        "included_true_cause_count",
        "denominator",
        "adjudication_reference"
      ],
      "title": "CandidateCoverage",
      "type": "object"
    },
    "CandidateExclusion": {
      "additionalProperties": false,
      "properties": {
        "component_pseudonym": {
          "maxLength": 128,
          "minLength": 12,
          "title": "Component Pseudonym",
          "type": "string"
        },
        "rationale_code": {
          "pattern": "^[a-z0-9][a-z0-9_.-]{0,127}$",
          "title": "Rationale Code",
          "type": "string"
        },
        "reason": {
          "$ref": "#/$defs/CandidateExclusionReason"
        }
      },
      "required": [
        "component_pseudonym",
        "reason",
        "rationale_code"
      ],
      "title": "CandidateExclusion",
      "type": "object"
    },
    "CandidateExclusionReason": {
      "enum": [
        "not_applicable",
        "invalid_topology_version",
        "outside_support",
        "data_unavailable",
        "policy_excluded",
        "generator_limit",
        "unresolved"
      ],
      "title": "CandidateExclusionReason",
      "type": "string"
    },
    "CandidateGeneratorIdentity": {
      "additionalProperties": false,
      "properties": {
        "algorithm_version": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Algorithm Version",
          "type": "string"
        },
        "configuration_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Configuration Sha256",
          "type": "string"
        },
        "feature_schema_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Feature Schema Sha256",
          "type": "string"
        },
        "policy_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Policy Sha256",
          "type": "string"
        },
        "topology_snapshot_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Topology Snapshot Sha256",
          "type": "string"
        }
      },
      "required": [
        "algorithm_version",
        "topology_snapshot_sha256",
        "feature_schema_sha256",
        "policy_sha256",
        "configuration_sha256"
      ],
      "title": "CandidateGeneratorIdentity",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "coverage": {
      "anyOf": [
        {
          "$ref": "#/$defs/CandidateCoverage"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "decision_cutoff_utc": {
      "format": "date-time",
      "title": "Decision Cutoff Utc",
      "type": "string"
    },
    "exclusions": {
      "default": [],
      "items": {
        "$ref": "#/$defs/CandidateExclusion"
      },
      "title": "Exclusions",
      "type": "array"
    },
    "generator": {
      "$ref": "#/$defs/CandidateGeneratorIdentity"
    },
    "included_candidates": {
      "items": {
        "type": "string"
      },
      "title": "Included Candidates",
      "type": "array"
    },
    "schema_version": {
      "default": "0.7.2",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "decision_cutoff_utc",
    "included_candidates",
    "generator"
  ],
  "title": "CandidateSet",
  "type": "object"
}
