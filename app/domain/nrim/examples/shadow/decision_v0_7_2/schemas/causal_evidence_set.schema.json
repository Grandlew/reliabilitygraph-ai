{
  "$defs": {
    "AlternativeHypothesis": {
      "additionalProperties": false,
      "properties": {
        "alternative_candidate_pseudonym": {
          "maxLength": 128,
          "minLength": 12,
          "title": "Alternative Candidate Pseudonym",
          "type": "string"
        },
        "candidate_pseudonym": {
          "maxLength": 128,
          "minLength": 12,
          "title": "Candidate Pseudonym",
          "type": "string"
        },
        "discriminator_obligation_ids": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Discriminator Obligation Ids",
          "type": "array"
        }
      },
      "required": [
        "candidate_pseudonym",
        "alternative_candidate_pseudonym",
        "discriminator_obligation_ids"
      ],
      "title": "AlternativeHypothesis",
      "type": "object"
    },
    "EvidenceApplicability": {
      "enum": [
        "applicable",
        "not_applicable",
        "unknown"
      ],
      "title": "EvidenceApplicability",
      "type": "string"
    },
    "EvidenceObligation": {
      "additionalProperties": false,
      "properties": {
        "applicability": {
          "$ref": "#/$defs/EvidenceApplicability"
        },
        "candidate_pseudonym": {
          "maxLength": 128,
          "minLength": 12,
          "title": "Candidate Pseudonym",
          "type": "string"
        },
        "expected_direction": {
          "$ref": "#/$defs/ExpectedDirection"
        },
        "mechanism_code": {
          "pattern": "^[a-z0-9][a-z0-9_.-]{0,127}$",
          "title": "Mechanism Code",
          "type": "string"
        },
        "obligation_id": {
          "pattern": "^obligation_[0-9a-f]{16,64}$",
          "title": "Obligation Id",
          "type": "string"
        },
        "observed_value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Observed Value"
        },
        "rationale_code": {
          "pattern": "^[a-z0-9][a-z0-9_.-]{0,127}$",
          "title": "Rationale Code",
          "type": "string"
        },
        "source_event_ids": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Source Event Ids",
          "type": "array"
        },
        "standardized_value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Standardized Value"
        },
        "status": {
          "$ref": "#/$defs/EvidenceStatus"
        },
        "time_relation": {
          "$ref": "#/$defs/EvidenceTimeRelation"
        }
      },
      "required": [
        "obligation_id",
        "candidate_pseudonym",
        "mechanism_code",
        "expected_direction",
        "time_relation",
        "applicability",
        "status",
        "rationale_code"
      ],
      "title": "EvidenceObligation",
      "type": "object"
    },
    "EvidenceStatus": {
      "enum": [
        "supports",
        "contradicts",
        "missing",
        "not_applicable",
        "unresolved"
      ],
      "title": "EvidenceStatus",
      "type": "string"
    },
    "EvidenceTimeRelation": {
      "enum": [
        "precedes",
        "coincides",
        "follows",
        "window_aggregate",
        "unresolved"
      ],
      "title": "EvidenceTimeRelation",
      "type": "string"
    },
    "ExpectedDirection": {
      "enum": [
        "increases",
        "decreases",
        "present",
        "absent",
        "unresolved"
      ],
      "title": "ExpectedDirection",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "alternatives": {
      "default": [],
      "items": {
        "$ref": "#/$defs/AlternativeHypothesis"
      },
      "title": "Alternatives",
      "type": "array"
    },
    "ambiguous": {
      "default": false,
      "title": "Ambiguous",
      "type": "boolean"
    },
    "obligations": {
      "items": {
        "$ref": "#/$defs/EvidenceObligation"
      },
      "title": "Obligations",
      "type": "array"
    },
    "ranked_candidates": {
      "items": {
        "type": "string"
      },
      "title": "Ranked Candidates",
      "type": "array"
    },
    "schema_version": {
      "default": "0.7.2",
      "title": "Schema Version",
      "type": "string"
    },
    "unresolved_reason_code": {
      "anyOf": [
        {
          "pattern": "^[a-z0-9][a-z0-9_.-]{0,127}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Unresolved Reason Code"
    }
  },
  "required": [
    "ranked_candidates",
    "obligations"
  ],
  "title": "CausalEvidenceSet",
  "type": "object"
}
