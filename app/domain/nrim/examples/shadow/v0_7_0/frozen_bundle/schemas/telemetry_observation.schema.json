{
  "$defs": {
    "Applicability": {
      "enum": [
        "observed",
        "missing",
        "not_applicable"
      ],
      "title": "Applicability",
      "type": "string"
    },
    "ComponentType": {
      "enum": [
        "signal_source",
        "gateway",
        "streamer",
        "middleware",
        "database",
        "catchup_service",
        "catchup_storage",
        "epg_service",
        "core_switch",
        "distribution_switch",
        "smart_tv_group"
      ],
      "title": "ComponentType",
      "type": "string"
    },
    "MetricName": {
      "enum": [
        "system.disk.utilization",
        "system.disk.io_latency",
        "system.disk.io_errors",
        "iptv.catchup.recording_failures",
        "system.process.restart_count",
        "iptv.session.active_count",
        "iptv.catchup.service_availability"
      ],
      "title": "MetricName",
      "type": "string"
    },
    "MetricUnit": {
      "enum": [
        "percent",
        "milliseconds",
        "errors_per_interval",
        "failures_per_interval",
        "restarts_per_interval",
        "sessions"
      ],
      "title": "MetricUnit",
      "type": "string"
    },
    "ObservationQuality": {
      "enum": [
        "high",
        "medium",
        "low",
        "quarantined"
      ],
      "title": "ObservationQuality",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "applicability": {
      "$ref": "#/$defs/Applicability"
    },
    "collector_id": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Collector Id",
      "type": "string"
    },
    "component_pseudonym": {
      "maxLength": 128,
      "minLength": 12,
      "title": "Component Pseudonym",
      "type": "string"
    },
    "component_type": {
      "$ref": "#/$defs/ComponentType"
    },
    "deployment_pseudonym": {
      "maxLength": 128,
      "minLength": 12,
      "title": "Deployment Pseudonym",
      "type": "string"
    },
    "event_time_utc": {
      "format": "date-time",
      "title": "Event Time Utc",
      "type": "string"
    },
    "ingestion_time_utc": {
      "format": "date-time",
      "title": "Ingestion Time Utc",
      "type": "string"
    },
    "metric_name": {
      "$ref": "#/$defs/MetricName"
    },
    "metric_value": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Metric Value"
    },
    "quality": {
      "$ref": "#/$defs/ObservationQuality"
    },
    "schema_version": {
      "default": "0.7.0",
      "title": "Schema Version",
      "type": "string"
    },
    "source_sequence_id": {
      "maxLength": 256,
      "minLength": 1,
      "title": "Source Sequence Id",
      "type": "string"
    },
    "topology_version": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Topology Version",
      "type": "string"
    },
    "unit": {
      "$ref": "#/$defs/MetricUnit"
    }
  },
  "required": [
    "deployment_pseudonym",
    "component_pseudonym",
    "component_type",
    "metric_name",
    "unit",
    "applicability",
    "quality",
    "event_time_utc",
    "ingestion_time_utc",
    "collector_id",
    "source_sequence_id",
    "topology_version"
  ],
  "title": "TelemetryObservation",
  "type": "object"
}