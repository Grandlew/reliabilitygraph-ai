{
  "$defs": {
    "ComponentType": {
      "enum": [
        "signal_source",
        "gateway",
        "streamer",
        "middleware",
        "database",
        "catchup_service",
        "catchup_storage",
        "epg_service",
        "core_switch",
        "distribution_switch",
        "smart_tv_group"
      ],
      "title": "ComponentType",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "component_pseudonym": {
      "maxLength": 128,
      "minLength": 12,
      "title": "Component Pseudonym",
      "type": "string"
    },
    "component_type": {
      "$ref": "#/$defs/ComponentType"
    },
    "deployment_pseudonym": {
      "maxLength": 128,
      "minLength": 12,
      "title": "Deployment Pseudonym",
      "type": "string"
    },
    "schema_version": {
      "default": "0.7.0",
      "title": "Schema Version",
      "type": "string"
    },
    "source_system": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Source System",
      "type": "string"
    },
    "topology_version": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Topology Version",
      "type": "string"
    },
    "valid_from_utc": {
      "format": "date-time",
      "title": "Valid From Utc",
      "type": "string"
    },
    "valid_to_utc": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Valid To Utc"
    }
  },
  "required": [
    "deployment_pseudonym",
    "component_pseudonym",
    "component_type",
    "valid_from_utc",
    "topology_version",
    "source_system"
  ],
  "title": "TopologyComponent",
  "type": "object"
}