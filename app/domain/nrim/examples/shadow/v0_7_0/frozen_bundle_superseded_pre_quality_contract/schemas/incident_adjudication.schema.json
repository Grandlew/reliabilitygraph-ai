{
  "$defs": {
    "AdjudicationConfidence": {
      "enum": [
        "confirmed",
        "probable",
        "uncertain"
      ],
      "title": "AdjudicationConfidence",
      "type": "string"
    },
    "IncidentSeverity": {
      "enum": [
        "low",
        "medium",
        "high",
        "critical"
      ],
      "title": "IncidentSeverity",
      "type": "string"
    },
    "ReviewAnswer": {
      "enum": [
        "yes",
        "no",
        "uncertain"
      ],
      "title": "ReviewAnswer",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "adjudication_id": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Adjudication Id",
      "type": "string"
    },
    "adjudication_version": {
      "minimum": 1,
      "title": "Adjudication Version",
      "type": "integer"
    },
    "blinded_initial_assessment": {
      "title": "Blinded Initial Assessment",
      "type": "boolean"
    },
    "confidence": {
      "$ref": "#/$defs/AdjudicationConfidence"
    },
    "confirmed_root_component": {
      "anyOf": [
        {
          "maxLength": 128,
          "minLength": 12,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Confirmed Root Component"
    },
    "created_at_utc": {
      "format": "date-time",
      "title": "Created At Utc",
      "type": "string"
    },
    "customer_impact_present": {
      "$ref": "#/$defs/ReviewAnswer"
    },
    "deployment_pseudonym": {
      "maxLength": 128,
      "minLength": 12,
      "title": "Deployment Pseudonym",
      "type": "string"
    },
    "evidence_note_source": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Evidence Note Source",
      "type": "string"
    },
    "evidence_notes": {
      "default": "",
      "maxLength": 8000,
      "title": "Evidence Notes",
      "type": "string"
    },
    "existing_monitor_detected_first": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Existing Monitor Detected First"
    },
    "impact_onset_utc": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Impact Onset Utc"
    },
    "nrim_top1_useful": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Nrim Top1 Useful"
    },
    "nrim_top3_useful": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Nrim Top3 Useful"
    },
    "observable_degradation_present": {
      "$ref": "#/$defs/ReviewAnswer"
    },
    "onset_time_confidence": {
      "anyOf": [
        {
          "$ref": "#/$defs/AdjudicationConfidence"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "onset_time_source": {
      "anyOf": [
        {
          "maxLength": 128,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Onset Time Source"
    },
    "prediction_ids": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Prediction Ids",
      "type": "array"
    },
    "recovery_utc": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Recovery Utc"
    },
    "review_window_end_utc": {
      "format": "date-time",
      "title": "Review Window End Utc",
      "type": "string"
    },
    "review_window_start_utc": {
      "format": "date-time",
      "title": "Review Window Start Utc",
      "type": "string"
    },
    "reviewer_id_pseudonym": {
      "maxLength": 128,
      "minLength": 12,
      "title": "Reviewer Id Pseudonym",
      "type": "string"
    },
    "root_cause_family": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Root Cause Family",
      "type": "string"
    },
    "schema_version": {
      "default": "0.7.0",
      "title": "Schema Version",
      "type": "string"
    },
    "severity": {
      "$ref": "#/$defs/IncidentSeverity"
    },
    "would_change_investigation_order": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Would Change Investigation Order"
    }
  },
  "required": [
    "adjudication_id",
    "deployment_pseudonym",
    "review_window_start_utc",
    "review_window_end_utc",
    "customer_impact_present",
    "observable_degradation_present",
    "severity",
    "root_cause_family",
    "confidence",
    "reviewer_id_pseudonym",
    "blinded_initial_assessment",
    "evidence_note_source",
    "adjudication_version",
    "created_at_utc"
  ],
  "title": "IncidentAdjudication",
  "type": "object"
}