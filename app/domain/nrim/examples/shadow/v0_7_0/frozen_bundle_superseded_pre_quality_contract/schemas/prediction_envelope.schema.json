{
  "$defs": {
    "DataQualityState": {
      "enum": [
        "accepted",
        "degraded",
        "blocked"
      ],
      "title": "DataQualityState",
      "type": "string"
    },
    "DecisionState": {
      "enum": [
        "healthy",
        "suspect",
        "incident",
        "recovery",
        "unknown",
        "escalate",
        "data_quality_escalation"
      ],
      "title": "DecisionState",
      "type": "string"
    },
    "RankedCause": {
      "additionalProperties": false,
      "properties": {
        "component_pseudonym": {
          "maxLength": 128,
          "minLength": 12,
          "title": "Component Pseudonym",
          "type": "string"
        },
        "evidence": {
          "additionalProperties": {
            "type": "number"
          },
          "title": "Evidence",
          "type": "object"
        },
        "score": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Score",
          "type": "number"
        }
      },
      "required": [
        "component_pseudonym",
        "score"
      ],
      "title": "RankedCause",
      "type": "object"
    },
    "SnapshotMode": {
      "enum": [
        "prospective",
        "late_data_replay",
        "golden_replay"
      ],
      "title": "SnapshotMode",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "activation_path": {
      "maxLength": 32,
      "minLength": 1,
      "title": "Activation Path",
      "type": "string"
    },
    "causal_consistency": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Causal Consistency"
    },
    "counterfactual_policy_states": {
      "additionalProperties": {
        "$ref": "#/$defs/DecisionState"
      },
      "title": "Counterfactual Policy States",
      "type": "object"
    },
    "created_at_utc": {
      "format": "date-time",
      "title": "Created At Utc",
      "type": "string"
    },
    "data_quality_state": {
      "$ref": "#/$defs/DataQualityState"
    },
    "data_quality_warnings": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Data Quality Warnings",
      "type": "array"
    },
    "decision_cutoff_utc": {
      "format": "date-time",
      "title": "Decision Cutoff Utc",
      "type": "string"
    },
    "deployment_pseudonym": {
      "maxLength": 128,
      "minLength": 12,
      "title": "Deployment Pseudonym",
      "type": "string"
    },
    "dual_path_state": {
      "anyOf": [
        {
          "$ref": "#/$defs/DecisionState"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "episode_state_after": {
      "$ref": "#/$defs/DecisionState"
    },
    "episode_state_before": {
      "anyOf": [
        {
          "$ref": "#/$defs/DecisionState"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "fast_path_state": {
      "anyOf": [
        {
          "$ref": "#/$defs/DecisionState"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "feature_schema_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Feature Schema Hash",
      "type": "string"
    },
    "feature_vector_hash": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Feature Vector Hash"
    },
    "final_decision": {
      "$ref": "#/$defs/DecisionState"
    },
    "healthy_residual": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Healthy Residual"
    },
    "impact_families": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Impact Families",
      "type": "array"
    },
    "impact_score": {
      "anyOf": [
        {
          "maximum": 1.0,
          "minimum": 0.0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Impact Score"
    },
    "inference_latency_ms": {
      "minimum": 0.0,
      "title": "Inference Latency Ms",
      "type": "number"
    },
    "infrastructure_version": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Infrastructure Version",
      "type": "string"
    },
    "model_bundle_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Model Bundle Hash",
      "type": "string"
    },
    "operational_profile_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Operational Profile Hash",
      "type": "string"
    },
    "policy_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Policy Hash",
      "type": "string"
    },
    "prediction_id": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Prediction Id",
      "type": "string"
    },
    "schema_version": {
      "default": "0.7.0",
      "title": "Schema Version",
      "type": "string"
    },
    "slow_path_state": {
      "anyOf": [
        {
          "$ref": "#/$defs/DecisionState"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "slow_path_statistic": {
      "anyOf": [
        {
          "minimum": 0.0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Slow Path Statistic"
    },
    "snapshot_mode": {
      "$ref": "#/$defs/SnapshotMode"
    },
    "stage1_probability": {
      "anyOf": [
        {
          "maximum": 1.0,
          "minimum": 0.0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Stage1 Probability"
    },
    "stage2_top_k": {
      "default": [],
      "items": {
        "$ref": "#/$defs/RankedCause"
      },
      "title": "Stage2 Top K",
      "type": "array"
    },
    "supersedes_prediction_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Supersedes Prediction Id"
    },
    "support_axes": {
      "additionalProperties": {
        "type": "number"
      },
      "title": "Support Axes",
      "type": "object"
    },
    "support_score": {
      "anyOf": [
        {
          "minimum": 0.0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Support Score"
    },
    "telemetry_snapshot_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Telemetry Snapshot Hash",
      "type": "string"
    },
    "topology_snapshot_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Topology Snapshot Hash",
      "type": "string"
    }
  },
  "required": [
    "prediction_id",
    "decision_cutoff_utc",
    "deployment_pseudonym",
    "snapshot_mode",
    "telemetry_snapshot_hash",
    "topology_snapshot_hash",
    "operational_profile_hash",
    "feature_schema_hash",
    "model_bundle_hash",
    "policy_hash",
    "episode_state_after",
    "final_decision",
    "activation_path",
    "data_quality_state",
    "inference_latency_ms",
    "infrastructure_version",
    "created_at_utc"
  ],
  "title": "PredictionEnvelope",
  "type": "object"
}