{
  "$defs": {
    "DependencyType": {
      "enum": [
        "depends_on",
        "sends_to",
        "authenticates_with",
        "stores_on",
        "serves",
        "connected_to"
      ],
      "title": "DependencyType",
      "type": "string"
    },
    "DirectionSemantics": {
      "enum": [
        "source_to_destination",
        "destination_depends_on_source",
        "bidirectional"
      ],
      "title": "DirectionSemantics",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "dependency_type": {
      "$ref": "#/$defs/DependencyType"
    },
    "deployment_pseudonym": {
      "maxLength": 128,
      "minLength": 12,
      "title": "Deployment Pseudonym",
      "type": "string"
    },
    "destination_component": {
      "maxLength": 128,
      "minLength": 12,
      "title": "Destination Component",
      "type": "string"
    },
    "direction_semantics": {
      "$ref": "#/$defs/DirectionSemantics"
    },
    "propagation_delay_minutes": {
      "default": 0,
      "minimum": 0,
      "title": "Propagation Delay Minutes",
      "type": "integer"
    },
    "propagation_strength": {
      "default": 1.0,
      "maximum": 1.0,
      "minimum": 0.0,
      "title": "Propagation Strength",
      "type": "number"
    },
    "schema_version": {
      "default": "0.7.0",
      "title": "Schema Version",
      "type": "string"
    },
    "source_component": {
      "maxLength": 128,
      "minLength": 12,
      "title": "Source Component",
      "type": "string"
    },
    "source_system": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Source System",
      "type": "string"
    },
    "topology_version": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Topology Version",
      "type": "string"
    },
    "valid_from_utc": {
      "format": "date-time",
      "title": "Valid From Utc",
      "type": "string"
    },
    "valid_to_utc": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Valid To Utc"
    }
  },
  "required": [
    "deployment_pseudonym",
    "source_component",
    "destination_component",
    "dependency_type",
    "direction_semantics",
    "valid_from_utc",
    "topology_version",
    "source_system"
  ],
  "title": "TopologyEdge",
  "type": "object"
}